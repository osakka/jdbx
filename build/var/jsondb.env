# JSONdb Server Environment Template
# v2.0.0 Binary Persistence Release
# 
# This is a template configuration file. Copy this to /opt/jsondb/var/jsondb.env
# and customize the values for your installation.

# ====================================================================
# CORE SERVER CONFIGURATION
# ====================================================================

# Server network configuration
# JSONDB_PORT=5000
# JSONDB_HOST=0.0.0.0

# Logging configuration
JSONDB_LOG_LEVEL=debug # Options: error, warn, info, debug, trace
JSONDB_VERBOSE=false

# ====================================================================
# BINARY PERSISTENCE CONFIGURATION (v2.0.0)
# ====================================================================

# Database path - Single JDBX file location
JSONDB_DB_DIR=/opt/jsondb/build/var

# RBAC configuration file
# JSONDB_RBAC_FILE=/opt/jsondb/build/var/rbac.json

# Server operation files
JSONDB_LOG_FILE=/opt/jsondb/build/var/jsondb.log
JSONDB_PID_FILE=/opt/jsondb/build/var/jsondb.pid

# ====================================================================
# DIRECTORY PATHS
# ====================================================================

# Web interface root directory
JSONDB_WEB_ROOT=/opt/jsondb/share/htdocs

# JavaScript integration directories
# JSONDB_VALIDATORS_DIR=/opt/jsondb/build/var/validators
# JSONDB_TRANSFORMS_DIR=/opt/jsondb/build/var/transforms

# Metrics and monitoring
# JSONDB_METRICS_DIR=/opt/jsondb/build/var/metrics

# ====================================================================
# JDBX DATABASE CONFIGURATION
# ====================================================================

# JDBX is the ONLY storage backend - no options needed!
# Single source of truth: Everything stored in one JDBX file

# JDBX configuration
JSONDB_JDBX_INITIAL_SIZE=104857600          # 100MB initial file size
JSONDB_JDBX_WAL_SIZE=10485760               # 10MB WAL size

# ====================================================================
# INITIAL ADMIN CONFIGURATION
# ====================================================================

# Initial admin user credentials (used on first startup)
JSONDB_INITIAL_ADMIN_USER=admin
JSONDB_INITIAL_ADMIN_PASSWORD=admin123

# Storage backend type: "mmap" (default) or "jdbx" (high-performance B-tree)
JSONDB_STORAGE_BACKEND=mmap

# ====================================================================
# ADVANCED CONFIGURATION
# ====================================================================

# Thread pool configuration (if supported)
# JSONDB_MAX_CONNECTIONS=100
# JSONDB_THREAD_POOL_MIN=4
# JSONDB_THREAD_POOL_MAX=16

# Binary persistence options
# JSONDB_BINARY_FORMAT=1                    # Force binary format (auto-detection by default)
# JSONDB_BINARY_SIZE_THRESHOLD=10485760     # Size threshold for auto-detection (10MB)

# ====================================================================
# SSL/TLS CONFIGURATION
# ====================================================================

# SSL/TLS options (enabled by default with certificates in /etc/ssl/)
JSONDB_USE_SSL=false
# JSONDB_SSL_CERT=/etc/ssl/certs/server.pem
# JSONDB_SSL_KEY=/etc/ssl/private/server.key
#
# Note: By default, SSL is enabled using certificates at:
#   Certificate: /etc/ssl/certs/server.pem
#   Private Key: /etc/ssl/private/server.key
# If you want to disable SSL, set JSONDB_USE_SSL=false

# ====================================================================
# DEBUG AND DEVELOPMENT
# ====================================================================

# Debug mode (set to true for development)
# JSONDB_DEBUG_MODE=false

# Individual debug categories (when debug mode is enabled)
# JSONDB_DEBUG_SOCKET=false
# JSONDB_DEBUG_RBAC=false
# JSONDB_DEBUG_API=false
# JSONDB_DEBUG_REQUEST=false
# JSONDB_DEBUG_AUTH=false
# JSONDB_DEBUG_PERSISTENCE=false

# ====================================================================
# QUICKJS INTEGRATION
# ====================================================================

# JavaScript execution timeout (in milliseconds)
# JSONDB_JS_TIMEOUT=5000

# Maximum JavaScript memory usage (in bytes)
# JSONDB_JS_MAX_MEMORY=16777216    # 16MB

# ====================================================================
# INSTALLATION NOTES
# ====================================================================
# 
# 1. Copy this file to /opt/jsondb/var/jsondb.env
# 2. Uncomment and modify the values you want to customize
# 3. The server will use built-in defaults for any unset values
# 4. Binary format is automatically enabled for optimal performance
# 5. All paths are absolute and should be adjusted for your installation
#
# ====================================================================
