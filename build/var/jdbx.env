# JSONdb Server Environment Configuration
# v4.0.0 - JDBX Rebranding
# 
# Configuration Priority (lowest to highest):
# 1. Environment file (this file) - loaded via --env-file or auto-discovery
# 2. Command-line flags - override environment values  
# 3. Database configuration (_system_config collection) - runtime changes
#
# Usage: ./bin/jdbxd --env-file=/path/to/this/file --daemon
# Or:    ./bin/jdbxd --daemon  # Auto-discovers this file

# ====================================================================
# BASE PATH CONFIGURATION
# ====================================================================
# Base installation directory (auto-detected if not set)
# JDBX_BASE_PATH=/opt/jdbx

# Derived paths (can be overridden individually)
# JDBX_DOC_PATH=${JDBX_BASE_PATH}/docs
# JDBX_VAR_PATH=${JDBX_BASE_PATH}/build/var

# ====================================================================
# CORE SERVER CONFIGURATION
# ====================================================================

# Server network configuration
# JDBX_PORT=5000
# JDBX_HOST=0.0.0.0

# Logging configuration
JDBX_LOG_LEVEL=trace # Options: error, warn, info, debug, trace
JDBX_VERBOSE=true

# ====================================================================
# DIRECTORY PATHS
# ====================================================================

# Server operation files (simplified - no subdirectories)
JDBX_LOG_FILE=/opt/jdbx/build/var/jdbxd.log
JDBX_PID_FILE=/opt/jdbx/build/var/jdbxd.pid

# Web interface root directory
# JDBX_WEB_ROOT=${JDBX_BASE_PATH}/share/htdocs

# ====================================================================
# DATABASE CONFIGURATION (v3.3.0 onwards)
# ====================================================================

# Database file basename (JDBX auto-generates .jdbx and .wal files) - no subdirectories
JDBX_DB_FILE=/opt/jdbx/build/var/jdbx

# JDBX configuration
JDBX_JDBX_INITIAL_SIZE=104857600          # 100MB initial file size
JDBX_JDBX_WAL_SIZE=10485760               # 10MB WAL size

# ====================================================================
# ADVANCED CONFIGURATION
# ====================================================================

# Thread pool configuration
# JDBX_MAX_CONNECTIONS=100
# JDBX_THREAD_POOL_MIN=4
# JDBX_THREAD_POOL_MAX=16
# JDBX_THREAD_POOL_QUEUE_SIZE=1024
# JDBX_THREAD_POOL_IDLE_TIMEOUT=60       # Seconds before idle threads exit

# Cache configuration
# JDBX_CACHE_ENABLED=true
# JDBX_CACHE_MAX_SIZE=10485760           # 10MB default
# JDBX_CACHE_TTL=300                     # 5 minutes default

# Metrics configuration
# JDBX_METRICS_ENABLED=true
# JDBX_METRICS_RETENTION=15              # Number of data points to retain

# Adaptive indexing configuration
# JDBX_INDEX_QUERY_THRESHOLD=10          # Queries before creating index
# JDBX_INDEX_TIME_THRESHOLD=50           # Average query time threshold (ms)
# JDBX_INDEX_QUERY_THRESHOLD_SYSTEM=5    # Lower threshold for system collections
# JDBX_INDEX_TIME_THRESHOLD_SYSTEM=10    # Lower time threshold for system collections (ms)
# JDBX_INDEX_STARTUP_DELAY=30            # Delay before indexing starts (seconds)
# JDBX_INDEX_CHECK_INTERVAL=60           # How often to check for new indexes (seconds)

# Binary persistence options
# JDBX_BINARY_FORMAT=1                    # Force binary format (auto-detection by default)
# JDBX_BINARY_SIZE_THRESHOLD=10485760     # Size threshold for auto-detection (10MB)

# ====================================================================
# SSL/TLS CONFIGURATION
# ====================================================================

# SSL/TLS options (enabled by default with certificates in /etc/ssl/)
JDBX_USE_SSL=true
# JDBX_SSL_CERT=/etc/ssl/certs/server.pem
# JDBX_SSL_KEY=/etc/ssl/private/server.key
#
# Note: By default, SSL is enabled using certificates at:
#   Certificate: /etc/ssl/certs/server.pem
#   Private Key: /etc/ssl/private/server.key
# If you want to disable SSL, set JDBX_USE_SSL=false

# ====================================================================
# DEBUG AND DEVELOPMENT
# ====================================================================

# Debug mode (set to true for development)
JDBX_DEBUG_MODE=true

# ====================================================================
# SECURITY CONFIGURATION (REQUIRED FOR PRODUCTION)
# ====================================================================

# Bootstrap admin credentials (REQUIRED for initial setup)
# CRITICAL: Change these for production deployments!
# 
# Example for development/testing:
# JDBX_BOOTSTRAP_ADMIN_USER=admin
# JDBX_BOOTSTRAP_ADMIN_PASS=secure_password_123
# JDBX_DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
#
# For production, use strong credentials:
# JDBX_BOOTSTRAP_ADMIN_USER=your_admin_username
# JDBX_BOOTSTRAP_ADMIN_PASS=your_very_secure_password_minimum_12_chars
# JDBX_DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
#
# JWT secret (optional - auto-generated if not provided)
# JDBX_JWT_SECRET=your_cryptographically_secure_jwt_secret_64_characters

# Individual debug categories (when debug mode is enabled)
JDBX_DEBUG_SOCKET=true
JDBX_DEBUG_RBAC=true
JDBX_DEBUG_API=true
JDBX_DEBUG_REQUEST=true
JDBX_DEBUG_AUTH=true
JDBX_DEBUG_PERSISTENCE=true

# ====================================================================
# QUICKJS INTEGRATION
# ====================================================================

# JavaScript execution timeout (in milliseconds)
# JDBX_JS_TIMEOUT=5000

# Maximum JavaScript memory usage (in bytes)
# JDBX_JS_MAX_MEMORY=16777216    # 16MB

# ====================================================================
# INSTALLATION NOTES
# ====================================================================
# 
# 1. Copy this file to your var directory (e.g., /opt/jdbx/var/jdbx.env)
# 2. Uncomment and modify the values you want to customize
# 3. The server will use built-in defaults for any unset values
# 4. Binary format is automatically enabled for optimal performance
# 5. Set JDBX_BASE_PATH to customize the installation directory
# 6. All other paths can use environment variable references
#
# ====================================================================
