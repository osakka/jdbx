#include "utils/production_config.h"
#include "utils/logger.h"
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

/* Global configuration instance */
production_config_t g_production_config = PROD_CONFIG_DEVELOPMENT;

/* Helper to format bytes */
const char* format_bytes(uint64_t bytes) {
    static char buffer[64];
    if (bytes >= 1ULL << 30) {
        snprintf(buffer, sizeof(buffer), "%.2f GB", bytes / (double)(1ULL << 30));
    } else if (bytes >= 1ULL << 20) {
        snprintf(buffer, sizeof(buffer), "%.2f MB", bytes / (double)(1ULL << 20));
    } else if (bytes >= 1ULL << 10) {
        snprintf(buffer, sizeof(buffer), "%.2f KB", bytes / (double)(1ULL << 10));
    } else {
        snprintf(buffer, sizeof(buffer), "%llu B", (unsigned long long)bytes);
    }
    return buffer;
}

/* Initialize production configuration */
void production_config_init(const char* config_level) {
    if (!config_level) {
        config_level = getenv("JSONDB_CONFIG_LEVEL");
    }
    
    if (!config_level || strcmp(config_level, "development") == 0) {
        g_production_config = PROD_CONFIG_DEVELOPMENT;
        LOG_INFO("Using DEVELOPMENT configuration.");
    } else if (strcmp(config_level, "small") == 0) {
        g_production_config = PROD_CONFIG_SMALL;
        LOG_INFO("Using SMALL production configuration (up to 1M documents).");
    } else if (strcmp(config_level, "medium") == 0) {
        g_production_config = PROD_CONFIG_MEDIUM;
        LOG_INFO("Using MEDIUM production configuration (up to 100M documents).");
    } else if (strcmp(config_level, "large") == 0) {
        g_production_config = PROD_CONFIG_LARGE;
        LOG_INFO("Using LARGE production configuration (up to 1B documents).");
    } else {
        LOG_WARNING("Unknown config level '%s', using development", config_level);
        g_production_config = PROD_CONFIG_DEVELOPMENT;
    }
    
    production_config_print();
}

/* Set custom configuration */
void production_config_set(const production_config_t* config) {
    if (config) {
        g_production_config = *config;
        LOG_INFO("Custom production configuration applied.");
        production_config_print();
    }
}

/* Get current configuration */
const production_config_t* production_config_get(void) {
    return &g_production_config;
}

/* Print current configuration */
void production_config_print(void) {
    LOG_INFO("Production Configuration:");
    LOG_INFO("  MMAP size per collection: %s", 
             format_bytes(g_production_config.mmap_size_per_collection));
    LOG_INFO("  Total cache size: %s", 
             format_bytes(g_production_config.cache_size_total));
    LOG_INFO("  Buffer pool size: %s", 
             format_bytes(g_production_config.buffer_pool_size));
    LOG_INFO("  Index batch size: %u", g_production_config.index_batch_size);
    LOG_INFO("  Lazy indexing: %s", g_production_config.lazy_indexing ? "enabled" : "disabled");
    LOG_INFO("  Pre-allocate storage: %s", g_production_config.preallocate_storage ? "enabled" : "disabled");
}