/**
 * Optimized JSON deep copy implementation with safety features
 * 
 * This implementation avoids the inefficient stringify/parse approach
 * and directly copies the JSON structure recursively with protection
 * against infinite loops and excessive recursion depth.
 */

#include "utils/json.h"
#include "utils/logger.h"
#include <string.h>
#include <stdlib.h>

/* Maximum recursion depth to prevent stack overflow */
#define MAX_RECURSION_DEPTH 100

/* Forward declaration */
static json_value_t* json_deep_copy_internal_safe(json_value_t* value, int depth);

/* Deep copy a JSON string value */
static json_value_t* copy_string(json_value_t* value) {
    if (!value || value->type != JSON_STRING) return NULL;
    
    return json_create_string(value->value.string);
}

/* Deep copy a JSON number value */
static json_value_t* copy_number(json_value_t* value) {
    if (!value || value->type != JSON_NUMBER) return NULL;
    
    return json_create_number(value->value.number);
}

/* Deep copy a JSON boolean value */
static json_value_t* copy_boolean(json_value_t* value) {
    if (!value || value->type != JSON_BOOLEAN) return NULL;
    
    return json_create_boolean(value->value.boolean);
}

/* Deep copy a JSON integer value */
static json_value_t* copy_integer(json_value_t* value) {
    if (!value || value->type != JSON_INTEGER) return NULL;
    
    return json_create_integer(value->value.integer);
}

/* Deep copy a JSON array value with depth safety */
static json_value_t* copy_array_safe(json_value_t* value, int depth) {
    if (!value || value->type != JSON_ARRAY) return NULL;
    if (depth > MAX_RECURSION_DEPTH) {
        LOG_WARNING("JSON deep copy: Maximum recursion depth exceeded for array.");
        return json_create_array(); // Return empty array to prevent crash
    }
    
    json_value_t* new_array = json_create_array();
    if (!new_array) return NULL;
    
    /* Copy each element with depth tracking */
    for (size_t i = 0; i < value->value.array.size; i++) {
        json_value_t* elem = json_array_get(value, i);
        if (elem) {
            json_value_t* elem_copy = json_deep_copy_internal_safe(elem, depth + 1);
            if (elem_copy) {
                json_array_append(new_array, elem_copy);
            }
        }
    }
    
    return new_array;
}

/* Deep copy a JSON object value with depth safety */
static json_value_t* copy_object_safe(json_value_t* value, int depth) {
    if (!value || value->type != JSON_OBJECT) return NULL;
    if (depth > MAX_RECURSION_DEPTH) {
        LOG_WARNING("JSON deep copy: Maximum recursion depth exceeded for object.");
        return json_create_object(); // Return empty object to prevent crash
    }
    
    json_value_t* new_obj = json_create_object();
    if (!new_obj) return NULL;
    
    /* Safe manual iteration with depth tracking */
    for (size_t i = 0; i < value->value.object.size; i++) {
        const char* key = value->value.object.entries[i].key;
        json_value_t* val = value->value.object.entries[i].value;
        
        if (key && val) {
            json_value_t* val_copy = json_deep_copy_internal_safe(val, depth + 1);
            if (val_copy) {
                json_object_set(new_obj, key, val_copy);
            }
        }
    }
    
    return new_obj;
}

/* Internal recursive deep copy function with safety checks */
static json_value_t* json_deep_copy_internal_safe(json_value_t* value, int depth) {
    if (!value) return NULL;
    
    /* Check for excessive recursion depth */
    if (depth > MAX_RECURSION_DEPTH) {
        LOG_WARNING("JSON deep copy: Maximum recursion depth exceeded, returning null.");
        return json_create_null();
    }
    
    switch (value->type) {
        case JSON_NULL:
            return json_create_null();
            
        case JSON_STRING:
            return copy_string(value);
            
        case JSON_NUMBER:
            return copy_number(value);
            
        case JSON_BOOLEAN:
            return copy_boolean(value);
            
        case JSON_INTEGER:
            return copy_integer(value);
            
        case JSON_ARRAY:
            return copy_array_safe(value, depth);
            
        case JSON_OBJECT:
            return copy_object_safe(value, depth);
            
        default:
            LOG_WARNING("JSON deep copy: Unknown JSON type %d", value->type);
            return json_create_null();
    }
}

/* Simple fallback copy for edge cases */
static json_value_t* json_copy_fallback(json_value_t* value) {
    if (!value) return NULL;
    
    switch (value->type) {
        case JSON_NULL:
            return json_create_null();
        case JSON_STRING:
            return json_create_string(value->value.string);
        case JSON_NUMBER:
            return json_create_number(value->value.number);
        case JSON_BOOLEAN:
            return json_create_boolean(value->value.boolean);
        case JSON_INTEGER:
            return json_create_integer(value->value.integer);
        case JSON_ARRAY:
            /* Return empty array for safety */
            return json_create_array();
        case JSON_OBJECT:
            /* Return empty object for safety */
            return json_create_object();
        default:
            return json_create_null();
    }
}

/* Public API for JSON deep copy with safety features */
json_value_t* json_deep_copy_optimized(json_value_t* value) {
    if (!value) return NULL;
    
    LOG_DEBUG("Starting optimized JSON deep copy with safety checks.");
    json_value_t* result = json_deep_copy_internal_safe(value, 0);
    
    if (!result) {
        LOG_WARNING("Optimized deep copy failed, using fallback.");
        result = json_copy_fallback(value);
    }
    
    LOG_DEBUG("JSON deep copy completed successfully.");
    return result;
}

/* Backwards compatible wrapper - now fully optimized and safe */
json_value_t* json_deep_copy(json_value_t* value) {
    return json_deep_copy_optimized(value);
}