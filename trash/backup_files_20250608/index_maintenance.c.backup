#include "database/index_maintenance.h"
#include "database/adaptive_indexer.h"
#include "database/index_metrics.h"
#include "utils/logger.h"
#include "utils/metrics.h"
#include <string.h>
#include <stdlib.h>
#include <time.h>
#include <sys/time.h>

/* Global index maintenance statistics */
static index_maintenance_stats_t g_index_maintenance_stats = {0};
static pthread_mutex_t g_stats_lock = PTHREAD_MUTEX_INITIALIZER;

/* Hook system for extensibility */
#define MAX_HOOKS_PER_OPERATION 10

typedef struct index_maintenance_hook_entry {
    index_maintenance_hook_t hook;
    void* user_data;
    int active;
} index_maintenance_hook_entry_t;

static index_maintenance_hook_entry_t g_hooks[3][MAX_HOOKS_PER_OPERATION]; /* 3 operations */
static pthread_mutex_t g_hooks_lock = PTHREAD_MUTEX_INITIALIZER;
static int g_index_maintenance_initialized = 0;

/* === Helper Functions === */

/**
 * Get current timestamp in milliseconds
 */
static double get_timestamp_ms(void) {
    struct timeval tv;
    gettimeofday(&tv, NULL);
    return (double)(tv.tv_sec * 1000) + (double)(tv.tv_usec / 1000.0);
}

/**
 * Update statistics
 */
static void update_stats(index_maintenance_operation_t operation, double time_ms, int success) {
    pthread_mutex_lock(&g_stats_lock);
    
    switch (operation) {
        case INDEX_MAINT_INSERT:
            g_index_maintenance_stats.inserts_processed++;
            break;
        case INDEX_MAINT_UPDATE:
            g_index_maintenance_stats.updates_processed++;
            break;
        case INDEX_MAINT_DELETE:
            g_index_maintenance_stats.deletes_processed++;
            break;
    }
    
    if (success) {
        g_index_maintenance_stats.index_updates_successful++;
    } else {
        g_index_maintenance_stats.index_updates_failed++;
    }
    
    g_index_maintenance_stats.total_time_ms += time_ms;
    
    uint64_t total_ops = g_index_maintenance_stats.inserts_processed +
                        g_index_maintenance_stats.updates_processed +
                        g_index_maintenance_stats.deletes_processed;
    
    if (total_ops > 0) {
        g_index_maintenance_stats.avg_time_per_operation_ms = 
            g_index_maintenance_stats.total_time_ms / total_ops;
    }
    
    pthread_mutex_unlock(&g_stats_lock);
}

/**
 * Call hooks for an operation
 */
static int call_hooks(index_maintenance_operation_t operation,
                     const char* collection_name,
                     json_value_t* document,
                     const char* document_id,
                     uint64_t offset) {
    pthread_mutex_lock(&g_hooks_lock);
    
    for (int i = 0; i < MAX_HOOKS_PER_OPERATION; i++) {
        if (g_hooks[operation][i].active && g_hooks[operation][i].hook) {
            int result = g_hooks[operation][i].hook(collection_name, document, 
                                                   document_id, offset, 
                                                   g_hooks[operation][i].user_data);
            if (result != 0) {
                pthread_mutex_unlock(&g_hooks_lock);
                LOG_WARNING("Index maintenance hook failed for operation %d", operation);
                return result;
            }
        }
    }
    
    pthread_mutex_unlock(&g_hooks_lock);
    return 0;
}

/* === Public Functions === */

int index_maintenance_init(void) {
    if (g_index_maintenance_initialized) {
        return 0; /* Already initialized */
    }
    
    /* Initialize statistics */
    memset(&g_index_maintenance_stats, 0, sizeof(g_index_maintenance_stats));
    
    /* Initialize hooks */
    memset(g_hooks, 0, sizeof(g_hooks));
    
    g_index_maintenance_initialized = 1;
    LOG_INFO("Index maintenance system initialized.");
    
    return 0;
}

void index_maintenance_cleanup(void) {
    if (!g_index_maintenance_initialized) {
        return;
    }
    
    /* Clear hooks */
    pthread_mutex_lock(&g_hooks_lock);
    memset(g_hooks, 0, sizeof(g_hooks));
    pthread_mutex_unlock(&g_hooks_lock);
    
    g_index_maintenance_initialized = 0;
    LOG_INFO("Index maintenance system cleaned up.");
}

int index_maintenance_handle_insert(const char* collection_name, 
                                   json_value_t* document,
                                   uint64_t document_offset) {
    if (!g_index_maintenance_initialized || !collection_name || !document) {
        return -1;
    }
    
    double start_time = get_timestamp_ms();
    int success = 1;
    
    TRACE_DB("Index maintenance: handling insert for collection %s at offset %lu", 
              collection_name, document_offset);
    
    /* Get document ID */
    json_value_t* id_field = json_object_get(document, "uuid");
    if (!id_field || id_field->type != JSON_STRING) {
        LOG_WARNING("Index maintenance: document missing UUID field.");
        return -1;
    }
    const char* document_id = id_field->value.string;
    
    /* Get all adaptive indexes for this collection */
    size_t index_count = 0;
    struct adaptive_index_info** indexes = index_maintenance_get_collection_indexes(collection_name, &index_count);
    
    if (indexes && index_count > 0) {
        TRACE_DB("Index maintenance: updating %zu adaptive indexes for insert", index_count);
        
        /* Update each index */
        for (size_t i = 0; i < index_count; i++) {
            if (!indexes[i]) continue;
            
            /* Extract field value */
            json_value_t* field_value = index_maintenance_extract_field_value(document, indexes[i]->field_path);
            
            /* Update index and record metrics */
            double op_start = get_timestamp_ms();
            int op_result = index_maintenance_update_field_index(collection_name, indexes[i]->field_path,
                                                    NULL, field_value, document_offset,
                                                    INDEX_MAINT_INSERT);
            double op_end = get_timestamp_ms();
            
            /* Record maintenance metrics */
            index_metrics_record_maintenance(collection_name, indexes[i]->field_path,
                                           "insert", op_end - op_start, op_result == 0);
            
            if (op_result != 0) {
                LOG_WARNING("Index maintenance: failed to update index for field %s", indexes[i]->field_path);
                success = 0;
            }
        }
        
        /* Free index list */
        free(indexes);
    }
    
    /* Call hooks */
    if (call_hooks(INDEX_MAINT_INSERT, collection_name, document, document_id, document_offset) != 0) {
        success = 0;
    }
    
    double end_time = get_timestamp_ms();
    update_stats(INDEX_MAINT_INSERT, end_time - start_time, success);
    
    TRACE_DB("Index maintenance: insert handling completed in %.2f ms", end_time - start_time);
    
    return success ? 0 : -1;
}

int index_maintenance_handle_update(const char* collection_name,
                                   json_value_t* old_document,
                                   json_value_t* new_document,
                                   const char* document_id,
                                   uint64_t old_offset,
                                   uint64_t new_offset) {
    (void)old_offset; /* Currently unused */
    if (!g_index_maintenance_initialized || !collection_name || !new_document || !document_id) {
        return -1;
    }
    
    double start_time = get_timestamp_ms();
    int success = 1;
    
    TRACE_DB("Index maintenance: handling update for collection %s, doc %s", 
              collection_name, document_id);
    
    /* Get all adaptive indexes for this collection */
    size_t index_count = 0;
    struct adaptive_index_info** indexes = index_maintenance_get_collection_indexes(collection_name, &index_count);
    
    if (indexes && index_count > 0) {
        TRACE_DB("Index maintenance: updating %zu adaptive indexes for update", index_count);
        
        /* Update each index */
        for (size_t i = 0; i < index_count; i++) {
            if (!indexes[i]) continue;
            
            /* Extract old and new field values */
            json_value_t* old_value = old_document ? 
                index_maintenance_extract_field_value(old_document, indexes[i]->field_path) : NULL;
            json_value_t* new_value = index_maintenance_extract_field_value(new_document, indexes[i]->field_path);
            
            /* Check if field changed */
            if (!old_document || index_maintenance_field_changed(old_document, new_document, indexes[i]->field_path)) {
                /* Update index and record metrics */
                double op_start = get_timestamp_ms();
                int op_result = index_maintenance_update_field_index(collection_name, indexes[i]->field_path,
                                                        old_value, new_value, new_offset,
                                                        INDEX_MAINT_UPDATE);
                double op_end = get_timestamp_ms();
                
                /* Record maintenance metrics */
                index_metrics_record_maintenance(collection_name, indexes[i]->field_path,
                                               "update", op_end - op_start, op_result == 0);
                
                if (op_result != 0) {
                    LOG_WARNING("Index maintenance: failed to update index for field %s", indexes[i]->field_path);
                    success = 0;
                }
            }
        }
        
        /* Free index list */
        free(indexes);
    }
    
    /* Call hooks */
    if (call_hooks(INDEX_MAINT_UPDATE, collection_name, new_document, document_id, new_offset) != 0) {
        success = 0;
    }
    
    double end_time = get_timestamp_ms();
    update_stats(INDEX_MAINT_UPDATE, end_time - start_time, success);
    
    TRACE_DB("Index maintenance: update handling completed in %.2f ms", end_time - start_time);
    
    return success ? 0 : -1;
}

int index_maintenance_handle_delete(const char* collection_name,
                                   json_value_t* document,
                                   const char* document_id,
                                   uint64_t document_offset) {
    if (!g_index_maintenance_initialized || !collection_name || !document_id) {
        return -1;
    }
    
    double start_time = get_timestamp_ms();
    int success = 1;
    
    TRACE_DB("Index maintenance: handling delete for collection %s, doc %s", 
              collection_name, document_id);
    
    /* Get all adaptive indexes for this collection */
    size_t index_count = 0;
    struct adaptive_index_info** indexes = index_maintenance_get_collection_indexes(collection_name, &index_count);
    
    if (indexes && index_count > 0) {
        TRACE_DB("Index maintenance: updating %zu adaptive indexes for delete", index_count);
        
        /* Update each index */
        for (size_t i = 0; i < index_count; i++) {
            if (!indexes[i]) continue;
            
            /* Extract field value */
            json_value_t* field_value = document ? 
                index_maintenance_extract_field_value(document, indexes[i]->field_path) : NULL;
            
            /* Update index and record metrics */
            double op_start = get_timestamp_ms();
            int op_result = index_maintenance_update_field_index(collection_name, indexes[i]->field_path,
                                                    field_value, NULL, document_offset,
                                                    INDEX_MAINT_DELETE);
            double op_end = get_timestamp_ms();
            
            /* Record maintenance metrics */
            index_metrics_record_maintenance(collection_name, indexes[i]->field_path,
                                           "delete", op_end - op_start, op_result == 0);
            
            if (op_result != 0) {
                LOG_WARNING("Index maintenance: failed to update index for field %s", indexes[i]->field_path);
                success = 0;
            }
        }
        
        /* Free index list */
        free(indexes);
    }
    
    /* Call hooks */
    if (call_hooks(INDEX_MAINT_DELETE, collection_name, document, document_id, document_offset) != 0) {
        success = 0;
    }
    
    double end_time = get_timestamp_ms();
    update_stats(INDEX_MAINT_DELETE, end_time - start_time, success);
    
    TRACE_DB("Index maintenance: delete handling completed in %.2f ms", end_time - start_time);
    
    return success ? 0 : -1;
}

