json_value_t* index_maintenance_extract_field_value(json_value_t* document, 
                                                   const char* field_path) {
    if (!document || !field_path) {
        return NULL;
    }
    
    /* Handle simple field names first */
    if (strchr(field_path, '.') == NULL) {
        return json_object_get(document, field_path);
    }
    
    /* Handle nested field paths with dot notation */
    char* path_copy = strdup(field_path);
    if (!path_copy) return NULL;
    
    json_value_t* current = document;
    char* token = strtok(path_copy, ".");
    
    while (token && current && current->type == JSON_OBJECT) {
        current = json_object_get(current, token);
        token = strtok(NULL, ".");
    }
    
    free(path_copy);
    return current;
}

int index_maintenance_field_value_to_string(json_value_t* field_value,
                                           char* buffer,
                                           size_t buffer_size) {
    if (!buffer || buffer_size == 0) {
        return -1;
    }
    
    if (!field_value) {
        buffer[0] = '\0';
        return 0;
    }
    
    switch (field_value->type) {
        case JSON_STRING:
            strncpy(buffer, field_value->value.string, buffer_size - 1);
            buffer[buffer_size - 1] = '\0';
            break;
        case JSON_NUMBER:
            snprintf(buffer, buffer_size, "%.15g", field_value->value.number);
            break;
        case JSON_INTEGER:
            snprintf(buffer, buffer_size, "%ld", (long)field_value->value.integer);
            break;
        case JSON_BOOLEAN:
            strncpy(buffer, field_value->value.boolean ? "true" : "false", buffer_size - 1);
            buffer[buffer_size - 1] = '\0';
            break;
        case JSON_NULL:
            strncpy(buffer, "null", buffer_size - 1);
            buffer[buffer_size - 1] = '\0';
            break;
        default:
            /* Non-indexable types */
            return -1;
    }
    
    return 0;
}

