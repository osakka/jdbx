#!/bin/bash
# JSONdb Server Environment Configuration
# This file contains environment variables used by the JSONdb server

# Base paths 
export JSONDB_BASE_DIR="/opt/jsondb"
export JSONDB_BUILD_DIR="${JSONDB_BASE_DIR}/build"
export JSONDB_VAR_DIR="${JSONDB_BASE_DIR}/var"
export JSONDB_SHARE_DIR="${JSONDB_BASE_DIR}/share"

# Server configuration
export JSONDB_PORT="5000"
export JSONDB_HOST="0.0.0.0"
export JSONDB_VERBOSE="false"
export JSONDB_LOG_LEVEL="info"  # error, warning, info, debug, trace

# Directory paths (absolute)
export JSONDB_DB_DIR="${JSONDB_VAR_DIR}/jsondb_database.json"
export JSONDB_LOG_FILE="${JSONDB_VAR_DIR}/jsondb_server.log"
export JSONDB_PID_FILE="${JSONDB_VAR_DIR}/jsondb_server.pid"
export JSONDB_WEB_ROOT="${JSONDB_SHARE_DIR}/htdocs"
export JSONDB_VALIDATORS_DIR="${JSONDB_VAR_DIR}/validators"
export JSONDB_TRANSFORMS_DIR="${JSONDB_VAR_DIR}/transforms"
export JSONDB_METRICS_DIR="${JSONDB_VAR_DIR}/metrics"
export JSONDB_RBAC_FILE="${JSONDB_VAR_DIR}/json_rbac.json"

# Advanced configuration
export JSONDB_MAX_CONNECTIONS="100"
export JSONDB_THREAD_POOL_MIN="4"
export JSONDB_THREAD_POOL_MAX="16"
export JSONDB_THREAD_POOL_QUEUE_SIZE="64"

# SSL/TLS Configuration
export JSONDB_USE_SSL="false"
export JSONDB_SSL_CERT_FILE="${JSONDB_VAR_DIR}/ssl/server.crt"
export JSONDB_SSL_KEY_FILE="${JSONDB_VAR_DIR}/ssl/server.key"

# Debug options
export JSONDB_DEBUG_MODE="false"
export JSONDB_DEBUG_LOG="${JSONDB_VAR_DIR}/debug.log"