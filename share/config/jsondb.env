# JSONdb Server Environment Template
# v3.1.0 - Complete Configuration System
# 
# This is a template configuration file. Copy this to /opt/jsondb/var/jsondb.env
# and customize the values for your installation.
#
# Configuration Priority (lowest to highest):
# 1. Environment variables (this file)
# 2. Command-line arguments
# 3. Database configuration (_system_config collection)

# ====================================================================
# BASE PATH CONFIGURATION
# ====================================================================
# Base installation directory (auto-detected if not set)
# JSONDB_BASE_PATH=/opt/jsondb

# Derived paths (can be overridden individually)
# JSONDB_DOC_PATH=${JSONDB_BASE_PATH}/docs
# JSONDB_VAR_PATH=${JSONDB_BASE_PATH}/build/var

# ====================================================================
# CORE SERVER CONFIGURATION
# ====================================================================

# Server network configuration
# JSONDB_PORT=5000
# JSONDB_HOST=0.0.0.0

# Logging configuration
# JSONDB_LOG_LEVEL=warn # Options: error, warn, info, debug, trace
# JSONDB_VERBOSE=false

# ====================================================================
# BINARY PERSISTENCE CONFIGURATION (v2.0.0)
# ====================================================================

# Database path
# JSONDB_DB_DIR=${JSONDB_VAR_PATH}/data

# RBAC configuration file
# JSONDB_RBAC_FILE=${JSONDB_VAR_PATH}/rbac.json

# Server operation files
# JSONDB_LOG_FILE=${JSONDB_VAR_PATH}/jsondb.log
# JSONDB_PID_FILE=${JSONDB_VAR_PATH}/jsondb.pid

# ====================================================================
# DIRECTORY PATHS
# ====================================================================

# Web interface root directory
# JSONDB_WEB_ROOT=${JSONDB_BASE_PATH}/share/htdocs

# JavaScript integration directories
# JSONDB_VALIDATORS_DIR=${JSONDB_VAR_PATH}/validators
# JSONDB_TRANSFORMS_DIR=${JSONDB_VAR_PATH}/transforms

# Metrics and monitoring
# JSONDB_METRICS_DIR=${JSONDB_VAR_PATH}/metrics

# ====================================================================
# ADVANCED CONFIGURATION
# ====================================================================

# Thread pool configuration
# JSONDB_MAX_CONNECTIONS=100
# JSONDB_THREAD_POOL_MIN=4
# JSONDB_THREAD_POOL_MAX=16
# JSONDB_THREAD_POOL_QUEUE_SIZE=1024
# JSONDB_THREAD_POOL_IDLE_TIMEOUT=60       # Seconds before idle threads exit

# Cache configuration
# JSONDB_CACHE_ENABLED=true
# JSONDB_CACHE_MAX_SIZE=10485760           # 10MB default
# JSONDB_CACHE_TTL=300                     # 5 minutes default

# Metrics configuration
# JSONDB_METRICS_ENABLED=true
# JSONDB_METRICS_RETENTION=15              # Number of data points to retain

# Adaptive indexing configuration
# JSONDB_INDEX_QUERY_THRESHOLD=10          # Queries before creating index
# JSONDB_INDEX_TIME_THRESHOLD=50           # Average query time threshold (ms)
# JSONDB_INDEX_QUERY_THRESHOLD_SYSTEM=5    # Lower threshold for system collections
# JSONDB_INDEX_TIME_THRESHOLD_SYSTEM=10    # Lower time threshold for system collections (ms)
# JSONDB_INDEX_STARTUP_DELAY=30            # Delay before indexing starts (seconds)
# JSONDB_INDEX_CHECK_INTERVAL=60           # How often to check for new indexes (seconds)

# Binary persistence options
# JSONDB_BINARY_FORMAT=1                    # Force binary format (auto-detection by default)
# JSONDB_BINARY_SIZE_THRESHOLD=10485760     # Size threshold for auto-detection (10MB)

# ====================================================================
# SSL/TLS CONFIGURATION
# ====================================================================

# SSL/TLS options (enabled by default with certificates in /etc/ssl/)
JSONDB_USE_SSL=true
# JSONDB_SSL_CERT=/etc/ssl/certs/server.pem
# JSONDB_SSL_KEY=/etc/ssl/private/server.key
#
# Note: By default, SSL is enabled using certificates at:
#   Certificate: /etc/ssl/certs/server.pem
#   Private Key: /etc/ssl/private/server.key
# If you want to disable SSL, set JSONDB_USE_SSL=false

# ====================================================================
# DEBUG AND DEVELOPMENT
# ====================================================================

# Debug mode (set to true for development)
# JSONDB_DEBUG_MODE=false

# Individual debug categories (when debug mode is enabled)
# JSONDB_DEBUG_SOCKET=false
# JSONDB_DEBUG_RBAC=false
# JSONDB_DEBUG_API=false
# JSONDB_DEBUG_REQUEST=false
# JSONDB_DEBUG_AUTH=false
# JSONDB_DEBUG_PERSISTENCE=false

# ====================================================================
# QUICKJS INTEGRATION
# ====================================================================

# JavaScript execution timeout (in milliseconds)
# JSONDB_JS_TIMEOUT=5000

# Maximum JavaScript memory usage (in bytes)
# JSONDB_JS_MAX_MEMORY=16777216    # 16MB

# ====================================================================
# INSTALLATION NOTES
# ====================================================================
# 
# 1. Copy this file to your var directory (e.g., /opt/jsondb/var/jsondb.env)
# 2. Uncomment and modify the values you want to customize
# 3. The server will use built-in defaults for any unset values
# 4. Binary format is automatically enabled for optimal performance
# 5. Set JSONDB_BASE_PATH to customize the installation directory
# 6. All other paths can use environment variable references
#
# ====================================================================
