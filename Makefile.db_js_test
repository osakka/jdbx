# Makefile for db_js_test.c - JavaScript and database integration test

CC = gcc
CFLAGS = -Wall -Isrc/include -DUSE_QUICKJS -g -O0

# Add QuickJS library and math functions
LDFLAGS = -pthread -L/opt/qjs/lib/quickjs -lquickjs -lm

# Target executable
TARGET = db_js_test

# Default target
all: $(TARGET)

# Linking rule
$(TARGET): db_js_test.o
	@echo "Linking $@..."
	$(CC) $^ -o $@ $(LDFLAGS)
	@echo "Build completed successfully!"
	@echo "Run with: ./$(TARGET)"

# Compile db_js_test.c
db_js_test.o: db_js_test.c
	@echo "Compiling $<..."
	$(CC) $(CFLAGS) -c $< -o $@

# Clean
clean:
	rm -f db_js_test.o $(TARGET)

# Run
run: $(TARGET)
	./$(TARGET)

.PHONY: all clean run