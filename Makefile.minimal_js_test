# Makefile for minimal_js_test.c - Minimal QuickJS test

CC = gcc
CFLAGS = -Wall -Isrc/include -DUSE_QUICKJS -g -O0

# Add QuickJS library and math functions
LDFLAGS = -pthread -L/opt/qjs/lib/quickjs -lquickjs -lm

# Target executable
TARGET = minimal_js_test

# Default target
all: $(TARGET)

# Linking rule
$(TARGET): minimal_js_test.o
	@echo "Linking $@..."
	$(CC) $^ -o $@ $(LDFLAGS)
	@echo "Build completed successfully!"
	@echo "Run with: ./$(TARGET)"

# Compile minimal_js_test.c
minimal_js_test.o: minimal_js_test.c
	@echo "Compiling $<..."
	$(CC) $(CFLAGS) -c $< -o $@

# Clean
clean:
	rm -f minimal_js_test.o $(TARGET)

# Run
run: $(TARGET)
	./$(TARGET)

.PHONY: all clean run