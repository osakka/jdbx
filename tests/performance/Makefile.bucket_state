CC = gcc
CFLAGS = -Wall -Wextra -g -O0 -pthread -I../../src/include -I../../build/include
LDFLAGS = -pthread -lm

SRCS = test_bucket_state.c \
       ../../src/components/index/hash_index.c \
       ../../src/components/storage/mmap_storage.c \
       ../../src/components/utils/logger.c

OBJS = $(SRCS:.c=.o)
TARGET = test_bucket_state

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)

run: $(TARGET)
	rm -f /tmp/test_bucket_state.idx /tmp/test_bucket_state.log
	./$(TARGET)

.PHONY: all clean run