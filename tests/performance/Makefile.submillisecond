CC = gcc
CFLAGS = -Wall -Wextra -O2 -pthread -I../../src/include -I../../build/include
LDFLAGS = -pthread -lm

# Link against the optimized library
LIBS = -L../../build/lib -ljsondb

TARGET = test_submillisecond
SRC = test_submillisecond.c

all: $(TARGET)

$(TARGET): $(SRC)
	$(CC) $(CFLAGS) -o $@ $< $(LIBS) $(LDFLAGS)

clean:
	rm -f $(TARGET)

run: $(TARGET)
	@echo "Running sub-millisecond performance test..."
	@rm -f /tmp/test_submillisecond.log
	./$(TARGET)

.PHONY: all clean run