# Makefile for simple_js_test.c - Minimal JavaScript engine test

CC = gcc
CFLAGS = -Wall -Isrc/include -DTOOLS_BUILD -DUSE_QUICKJS -g -O0 -DDEBUG

# Add QuickJS library and math functions
LDFLAGS = -pthread -L/opt/qjs/lib/quickjs -lquickjs -lm

# Minimal set of source files needed
SRC_FILES = src/components/utils/json.c \
            src/components/utils/logger.c \
            src/components/utils/js_file_utils.c \
            src/components/js/js_engine.c

# Object files
OBJ_FILES = $(SRC_FILES:.c=.o)

# Target executable
TARGET = simple_js_test

# Default target
all: $(TARGET)

# Linking rule
$(TARGET): simple_js_test.o $(OBJ_FILES)
	@echo "Linking $@..."
	@mkdir -p var/log/jsondb
	$(CC) $^ -o $@ $(LDFLAGS)
	@echo "Build completed successfully!"
	@echo "Run with: ./$(TARGET)"

# Compile simple_js_test.c
simple_js_test.o: simple_js_test.c
	@echo "Compiling $<..."
	$(CC) $(CFLAGS) -c $< -o $@

# Generic compilation rule for source files
%.o: %.c
	@echo "Compiling $<..."
	$(CC) $(CFLAGS) -c $< -o $@

# Clean
clean:
	rm -f simple_js_test.o $(OBJ_FILES) $(TARGET)

# Run
run: $(TARGET)
	./$(TARGET)

.PHONY: all clean run